; Dungeon Recall — Godot 4.7 port.
; Data-driven: everything that used to live in src/data/*.ts is JSON under res://data/.
; Regenerate the JSON with tools/import/convert.mjs (never hand-edit res://data/).

config_version=5

[application]

config/name="Dungeon Recall"
config/description="Portrait auto-combat ARPG — D2-style itemisation, five acts, three difficulties."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
; The PWA's own shield icon (`public/icon-512.png`), not Godot's default robot: the
; launcher icon, the OS window icon and the web manifest's 144/180/512 PNGs are all
; generated from this one file.
config/icon="res://assets/icon/icon.png"

[display]

; LANDSCAPE — the experiment Jan asked for (Nov 2026): "zkusme to na soubojové aréně (nájezdech)
; a uvidíme jak to bude fungovat." The canvas is landscape now, and ONLY the survivor run uses
; it (`Main.LANDSCAPE_SCREENS`); every other screen still lays out for 390x844 and hangs in
; `Main._portrait_root`, a fixed 390x844 Control scaled to the canvas height. So the measured
; portrait offsets survive while the arena gets the floor space that was the point of the change.
; When the rest of the game moves to landscape this comment and `_portrait_root` both go.
window/size/viewport_width=844
window/size/viewport_height=390
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[audio]

; ⚠️  The web export mixes audio ON THE MAIN THREAD. `index.audio.worklet.js` is built with
; `threads = false`, so the AudioWorklet only copies whatever the game thread has already
; mixed into a ring buffer; measured against Godot's own
; `AudioDriverWeb`: buffer_length = closest_power_of_2(output_latency * mix_rate / 1000).
; At the default 15 ms that is 1024 frames — 23 ms of sound. One frame that runs long and
; the buffer is empty: music drops out and the next chunk arrives as a crackle. That is
; exactly the pair Jan reports together ("hra se občas seká, včetně hudby" + "efekty
; praskají a šumí"), and on a phone the frame budget is what makes it happen.
;
; 40 ms -> 2048 frames -> 46 ms of buffer, twice the tolerance, at the cost of ~23 ms of
; extra tap-to-sound latency. A native build mixes on its own thread and only gets the
; same, harmless, latency.
driver/output_latency=40

[rendering]

; The PWA's body background is #121212. Godot's default clear colour is a mid grey, and
; every screen that does not paint its own background (the arena) came out grey because
; of it — which reads as a different game at a glance.
environment/defaults/default_clear_color=Color(0.0705882, 0.0705882, 0.0705882, 1)
textures/canvas_textures/default_texture_filter=1
; Required by the Android export preset: without it Godot refuses with
; "ETC2/ASTC texture compression is required for Android export".
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
