; Zily 2 — srdce a vez. Novy smer (viz skill ley-lines-gamedev,
; references/new-direction-heart.md).
config_version=5

[application]

config/name="Žily 2"
config/description="Srdce a věž — jedna věž ve středu kruhové plochy, která vidí jen svou barvu."
config/icon="res://icons/icon_512.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
